# ==============================================================================
# Antigravity Multi-Account Pool & Quota Configuration (Env-Driven)
# ==============================================================================
# Injectez vos comptes Google directement via les variables d'environnement
# sans aucune information d'authentification codée en dur dans le code source.

# Option 1 : Injection du JSON brut directement dans la variable (Recommandé pour Coolify / Docker)
# Collez le contenu complet du tableau JSON exporté (ex: antigravity_accounts_2026-09-11.json)
# AG_ACCOUNTS_JSON='[{"email":"amine.benammar17@gmail.com","refresh_token":"1//..."},{"email":"lignelady@gmail.com","refresh_token":"1//..."}]'

# Option 2 : Chemin vers le fichier JSON de comptes (Recommandé en local / volume monté)
# AG_ACCOUNTS_FILE="antigravity_accounts_2026-09-11.json"

# Compte actif initial (Optionnel : si omis, sélectionne le premier compte du pool ou le dernier utilisé)
# AG_ACTIVE_ACCOUNT="lignelady@gmail.com"

# Rotation automatique sur épuisement de quota (HTTP 429 / RESOURCE_EXHAUSTED)
# 1 = Activé (défaut), 0 = Désactivé
AG_AUTO_ROTATE="1"

# Identifiants client OAuth Google (Optionnel : configurables si besoin)
# AG_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# AG_GOOGLE_CLIENT_SECRET="your-client-secret"
