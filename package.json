{
  "name": "antigravity-patch-proxy",
  "productName": "Antigravity Patch Proxy",
  "version": "3.4.2",

  "description": "Antigravity Patch Proxy — Multi-Provider AI Model Proxy for Google Antigravity",
  "homepage": "https://antigravity.google",
  "author": {
    "name": "Amine Twiti"
  },
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "doctor": "node ag-doctor/bin/ag-doctor.js doctor",
    "doctor:check": "node ag-doctor/bin/ag-doctor.js check",
    "doctor:repair": "node ag-doctor/bin/ag-doctor.js repair --yes",
    "doctor:models": "node ag-doctor/bin/ag-doctor.js models list",
    "doctor:logs": "node ag-doctor/bin/ag-doctor.js logs -f -n 100",
    "doctor:ui:build": "cd ag-doctor-ui && npm run build",
    "doctor:ui:installer": "cd ag-doctor-ui && npm run dist:installer",
    "doctor:ui:portable": "cd ag-doctor-ui && npm run dist:portable",
    "doctor:ui:dist": "cd ag-doctor-ui && npm run dist:all",

    "patch:version": "node scripts/patch-version.js",
    "patch:2.2": "node scripts/patch_2_2_1.js",
    "patch:2.3": "node scripts/patch_2_3.js",
    "patch:2.5": "node scripts/patch_2_5.js",
    "patch:2.8": "node scripts/patch_2_5.js",
    "repack:win": "powershell -ExecutionPolicy Bypass -File scripts/repack/repack.ps1",
    "repack:mac": "bash scripts/deploy/deploy.sh",
    "repack:linux": "bash scripts/deploy/deploy_linux.sh",
    "mitm:start": "powershell -ExecutionPolicy Bypass -File scripts/mitm/start_mitm_443.ps1",
    "mitm:restart": "cmd /c scripts\\\\mitm\\\\restart-mitm.bat",
    "repatch": "cmd /c repatch.bat",
    "start:mitm": "cmd /c \"Start Antigravity MITM.bat\"",
    "remote:ui": "npm --prefix remote/antigravity-remote-daemon start",
    "remote:build": "npm --prefix remote/antigravity-remote-daemon run build"
  },
  "dependencies": {
    "chrome-devtools-mcp": "^0.23.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "shell-env": "^4.0.3"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^20.10.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
