# ==============================================================================
# ANTIGRAVITY PATCH PROXY & REMOTE DAEMON - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# All variables are optional and will fallback to secure local defaults.

# ─── 1. Desktop Proxy & Electron Lifecycle ──────────────────────────────────
# Host interface for the local proxy server (default: 127.0.0.1)
AG_BIND_HOST=127.0.0.1

# TCP port for the local proxy server (default: 51074)
AG_PROXY_PORT=51074

# TCP port for the ag-doctor-ui emergency proxy stub (default: 51999)
AG_STUB_PORT=51999

# SHA-256 fingerprint of the bundled language server certificate
AG_LS_CERT_FINGERPRINT=sha256/sTZpQemOWEytaZqa7P/y/dNXbHMdOAzMvzHEhUwHZXw=

# Upstream Google Cloud Code Host (default: daily-cloudcode-pa.googleapis.com)
AG_GOOGLE_CLOUDCODE_HOST=daily-cloudcode-pa.googleapis.com

# Upstream Google Generative Language Host (default: generativelanguage.googleapis.com)
AG_GOOGLE_GENLANG_HOST=generativelanguage.googleapis.com

# ─── 2. Proxy Network Timeouts & Resilience (in milliseconds) ───────────────
# Timeout for Google Cloud Code upstream requests (default: 60000 ms)
AG_GOOGLE_PROXY_TIMEOUT_MS=60000

# Timeout for downloading external URIs/files (default: 30000 ms)
AG_FILE_DOWNLOAD_TIMEOUT_MS=30000

# Per-chunk idle timeout for streaming SSE requests (default: 60000 ms)
AG_STREAM_IDLE_TIMEOUT_MS=60000

# Default timeout for custom model upstream requests (default: 30000 ms)
AG_MODEL_REQUEST_TIMEOUT_MS=30000

# Maximum number of retry attempts per model request (default: 1)
AG_MAX_RETRIES=1

# Circuit Breaker: Consecutive failures before backoff (default: 3)
AG_CACHE_REFRESH_MAX_FAILURES=3

# Circuit Breaker: Backoff duration in milliseconds (default: 300000 ms = 5 min)
AG_CACHE_REFRESH_BACKOFF_MS=300000

# ─── 3. Remote Daemon Bridge (Go) ───────────────────────────────────────────
# TCP port for the Daemon WebSocket & HTTP server (default: 8090)
AG_DAEMON_PORT=8090

# Host interface for the Daemon bridge (default: 0.0.0.0)
AG_DAEMON_HOST=0.0.0.0

# TCP port of the local Antigravity Language Server (default: 55256)
AG_LS_PORT=55256

# Tunnel provider for remote pairing: cloudflare | pinggy | pangolin | ngrok | local
AG_TUNNEL_PROVIDER=

# Authentication token for pairing mobile clients (leave empty for dynamic CSPRNG)
AG_AUTH_TOKEN=

# Auto-deny timeout for pending tool execution approvals (default: 5m)
AG_APPROVAL_TIMEOUT=5m

# Polling interval for Language Server quota updates (default: 60s)
AG_QUOTA_INTERVAL=60s

# Allow remote interactive PTY terminal execution (default: true)
AG_ALLOW_REMOTE_TERMINAL=true

# Discovery UDP broadcast port (default: 41234)
AG_DISCOVERY_PORT=41234

# ─── 4. Flutter Mobile Companion App (--dart-define) ────────────────────────
# Environment tier: development | staging | production
ENVIRONMENT=development

# Host IP or tunnel URL of the remote daemon
DAEMON_HOST=10.0.2.2

# Port of the remote daemon
DAEMON_PORT=8090

# Pre-shared authentication token
AUTH_TOKEN=

# Enable SSL/TLS (wss:// and https://)
USE_SSL=false

# Enable debug logging in the mobile console
ENABLE_LOGGING=true

# ─── 5. Enterprise LLM Provider Base URLs & Sampling Overrides ──────────────
# OpenAI Base URL (or LiteLLM / Azure proxy) (default: https://api.openai.com/v1)
OPENAI_BASE_URL=

# Anthropic Base URL (default: https://api.anthropic.com/v1)
ANTHROPIC_BASE_URL=

# DeepSeek Base URL (default: https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=

# OpenRouter Base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=

# Local Ollama Host / Base URL (default: http://localhost:11434)
OLLAMA_HOST=

# Groq / Mistral / Moonshot Base URLs
GROQ_BASE_URL=
MISTRAL_BASE_URL=
KIMI_BASE_URL=

# Model context & sampling limits
AG_CUSTOM_MODEL_MAX_TOKENS=1048576
AG_CUSTOM_MODEL_MAX_OUTPUT_TOKENS=4096
AG_DEFAULT_TEMPERATURE=0.7
AG_DEFAULT_TOP_P=0.9
AG_DEFAULT_TOP_K=40

