# ==============================================================================
# Antigravity Patch Proxy - Comprehensive .gitignore
# ==============================================================================

# Node dependencies & caches
node_modules/
.npmrc.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build and distribution outputs
dist/
dist-build/
vendors/
certs/
bin/
*.exe
*.dll
*.so
*.dylib
*.node
*.asar
/app.asar.new
/preload.js
/temp_asar/
/daemon.exe

# Doctor UI & daemon build outputs
ag-doctor-ui/dist/
ag-doctor-ui/release/
ag-doctor-ui/tools/*
remote/daemon/bin/
remote/daemon/*.exe
remote/daemon/*.exe~
remote/daemon/*.dll
remote/daemon/*.cmd
remote/daemon/*.vbs
remote/daemon/*.ps1
remote/daemon/*.js
remote/daemon/*.txt
remote/daemon/%TEMP%/
remote/daemon/*.crt
remote/daemon/*.key

# Mobile / Flutter / Gradle outputs & caches
remote/mobile/.gradle/
remote/mobile/.flutter-plugins
remote/mobile/.flutter-plugins-dependencies
remote/mobile/.dart_tool/
remote/mobile/build/
remote/mobile/ephemeral/
remote/mobile/android/.gradle/
remote/mobile/ios/Pods/
remote/mobile/ios/.symlinks/

# OS metadata & editor temp files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Development logs & diagnostic dumps
*.log
log
logs/
logs/*.log
logs/*.txt
build_log.txt
diag_*.txt
eslint_out.txt
git_status.txt
tsc_*.txt
standalone*.log
remote/daemon/*.log

# Temporary test, extract & scratch directories
scratch/
test-extract/
.kimchi/
.impeccable/
review/
videos/
tools/*
tool/
remote/tools/*
remote/tools1/*
remote/tools2/*
remote/tools3/*
remote/vendor/*
remote/insperer/*
release/*
archive/
_archive/
*.rar
*.tar.gz
*.zip
*.7z

# Account tokens, credentials & runtime state (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.schema.json
accounts.env
accounts.env.*
!accounts.env.example
antigravity_accounts_*.json
*accounts*.json
!ag-doctor/src/**/accounts*.json
providerState.json
test_marker.txt
config.bat
challenges.html
challenge_urls.json
dump_step.js
inspect_*.js
.compact_context.md
issues*.json

# Temporary script outputs & debug scratches
scripts/*.txt
scripts/check.py
scripts/check_hook.py
scripts/do_fix.py
scripts/test.py
scripts/debug_lines.txt
scripts/hook_slice.txt
scripts/patch_result.txt
scripts/freebuff/extraction-output.txt
scripts/freebuff/pkce-output.txt
UsersAdminAppDataLocalTemppv-test-*
