{
  "name": "antigravity-remote-daemon",
  "productName": "Antigravity Remote Daemon",
  "version": "3.5.0",
  "description": "Antigravity Remote Daemon — Dedicated 1-Page Controller for Remote Server & Mobile Pairing",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/copy-assets.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/strip-module-syntax.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "keywords": [
    "antigravity",
    "remote",
    "daemon",
    "mobile",
    "electron"
  ],
  "author": "Antigravity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aminetwiti/antigravity-patch-proxy.git"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "electronVersion": "44.0.0",
    "appId": "dev.antigravity.remote-daemon",
    "productName": "Antigravity Remote Daemon",
    "publish": {
      "provider": "github",
      "owner": "Aminetwiti",
      "repo": "antigravity-patch-proxy"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "antigravity-remote-daemon-${version}-portable.${ext}"
    }
  }
}
